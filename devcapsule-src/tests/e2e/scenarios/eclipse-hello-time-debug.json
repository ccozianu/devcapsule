  "id": "eclipse-hello-time-debug",
  "surface": "eclipse",
  "title": "Eclipse IDE for Java Developers: Step-by-Step Debugging of a System-Time Greeting",
  "description": "Run an Eclipse/Java DevCapsule, open a Java application that formats the current system time into 'Hello world, time is now ${TIME}', set a line breakpoint where the system time is retrieved (LocalDateTime.now()), launch the debugger, and step line-by-line while inspecting Variables and Console output.",
  "seed_files": {
    ".project": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<projectDescription>\n\t<name>HelloTime</name>\n\t<comment></comment>\n\t<projects>\n\t</projects>\n\t<buildSpec>\n\t\t<buildCommand>\n\t\t\t<name>org.eclipse.jdt.core.javabuilder</name>\n\t\t\t<arguments>\n\t\t\t</arguments>\n\t\t</buildCommand>\n\t</buildSpec>\n\t<natures>\n\t\t<nature>org.eclipse.jdt.core.javanature</nature>\n\t</natures>\n</projectDescription>\n",
    ".classpath": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<classpath>\n\t<classpathentry kind=\"con\" path=\"org.eclipse.jdt.launching.JRE_CONTAINER\"/>\n\t<classpathentry kind=\"src\" path=\"src\"/>\n\t<classpathentry kind=\"output\" path=\"bin\"/>\n</classpath>\n",
    "src/HelloTime.java": "import java.time.LocalDateTime;\nimport java.time.format.DateTimeFormatter;\n\npublic class HelloTime {\n    public static void main(String[] args) {\n        LocalDateTime now = LocalDateTime.now();\n        String timestamp = now.format(DateTimeFormatter.ofPattern(\"yyyy-MM-dd HH:mm:ss\"));\n        String message = \"Hello world, time is now \" + timestamp;\n        System.out.println(message);\n    }\n}\n"
  },
